{
  "name": "flow-crm",
  "private": true,
  "version": "1.0.0",
  "productName": "flow.crm",
  "description": "Local desktop CRM for freelance designers",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --configLoader runner --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build --configLoader runner",
    "dist": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir --win --x64",
    "check": "tsc -b"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.flowcrm.desktop",
    "productName": "flow.crm",
    "directories": { "output": "../", "buildResources": "build" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asarUnpack": ["node_modules/better-sqlite3/**/*"],
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "flow.crm-Setup-${version}-${arch}.${ext}"
    },
    "portable": { "artifactName": "flow.crm-Portable-${version}-${arch}.${ext}" }
  }
}
